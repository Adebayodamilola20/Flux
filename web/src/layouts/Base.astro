---
import { SEO, PRODUCT } from '../config/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = SEO.title, description = SEO.description } = Astro.props;

/**
 * Canonical URL.
 *
 * `Astro.site` is only defined when `site` is set in astro.config, and it is
 * absent in some dev contexts — `new URL(path, undefined)` throws "Invalid
 * URL" and takes the whole page down with it. A missing canonical is a minor
 * SEO gap; a render crash is not. So it degrades to null and the tags that
 * need an absolute URL are simply omitted.
 */
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#e6f5f1" />

    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/logo-512.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={PRODUCT.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}

    {canonical && <meta property="og:image" content={new URL('/logo-512.png', Astro.site).href} />}

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {canonical && <meta name="twitter:image" content={new URL('/logo-512.png', Astro.site).href} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
