---
import { PRIMARY_DOWNLOAD, PRODUCT } from '../config/site';

/**
 * One card, the way the reference does it: the app's own icon, its name, the
 * minimum OS, the artefact line, and a single button.
 *
 * The button is driven entirely by config. While `available` is false there is
 * no binary to hand over, so it says so rather than linking nowhere — set
 * `DOWNLOADS[0].url` and `available: true` and this becomes a real download.
 */
const d = PRIMARY_DOWNLOAD;
const ready = d.available && d.url;
---

<section class="dl">
  <div class="wrap center">
    <h1 class="display title">
      Download {PRODUCT.name}<br />for <span class="mark">Mac</span>
    </h1>

    <p class="sub">
      Once downloaded, run the DMG and move <strong>{PRODUCT.name}</strong> to
      your Applications folder <em>before</em> launching it.
    </p>

    <div class="card">
      <div class="icon">
        <!-- The app's own icon, the one the Dock and the Keychain prompt
             show. It used to be drawn here in SVG, which meant the picture on
             the download page was not the thing being downloaded. -->
        <img
          class="appicon"
          src="/logo-512.png"
          alt="The DevNotch app icon"
          width="512"
          height="512"
        />
      </div>

      <h2 class="name">{PRODUCT.name}</h2>
      <p class="req">Minimum {PRODUCT.minOS}</p>
      <p class="meta">DMG · v{PRODUCT.version} · {d.detail}{ready ? '' : ' · not yet published'}</p>

      {
        ready ? (
          <a class="btn get" href={d.url} download>
            <span class="get__arrow">
              <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                <path d="M8 2v9m0 0 3.5-3.5M8 11 4.5 7.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
            Download
          </a>
        ) : (
          <span class="btn get get--off" aria-disabled="true">
            No build published yet
          </span>
        )
      }
      {
        ready && d.note ? (
          <p class="note">{d.note}</p>
        ) : null
      }
    </div>

  </div>
</section>

<style>
  .appicon {
    width: 112px;
    height: 112px;
    display: block;
    border-radius: 25px;
  }

  .dl {
    padding-block: clamp(3rem, 8vw, 6rem) clamp(4rem, 9vw, 7rem);
  }

  .title {
    max-width: 16ch;
    margin-inline: auto;
    animation: rise 0.6s var(--ease-out) both;
  }

  .sub {
    margin: clamp(1.5rem, 3vw, 2.25rem) auto 0;
    max-width: 40ch;
    font-size: clamp(1rem, 1.6vw, 1.125rem);
    line-height: 1.5;
    color: var(--ink-2);
    text-wrap: pretty;
    animation: rise 0.6s var(--ease-out) 90ms both;
  }

  .sub strong {
    font-weight: 650;
    color: var(--ink);
  }

  .card {
    margin: clamp(2.5rem, 5vw, 3.5rem) auto 0;
    width: min(23rem, 100%);
    padding: 2rem 1.75rem 1.75rem;
    background: var(--paper-2);
    border-radius: var(--r-lg);
    box-shadow: 0 1px 2px rgba(20, 24, 27, 0.04);
    animation: card-in 0.7s var(--ease-out) 180ms both;
    transition:
      transform var(--mid) var(--ease-out),
      box-shadow var(--mid) var(--ease-out);
  }

  .card:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 40px -14px rgba(20, 24, 27, 0.28);
  }

  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateY(18px) scale(0.97);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .icon {
    display: flex;
    justify-content: center;
    filter: drop-shadow(0 14px 26px rgba(20, 24, 27, 0.3));
    animation: float 5s var(--ease-in-out) infinite;
  }

  /* A slow drift, so the icon reads as an object rather than a sticker. */
  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-5px);
    }
  }

  .card:hover .icon {
    animation-play-state: paused;
  }

  .name {
    margin-top: 1.25rem;
    font-size: 1.25rem;
    letter-spacing: -0.03em;
  }

  .req {
    margin-top: 0.375rem;
    font-size: 0.9375rem;
    color: var(--ink-2);
  }

  .meta {
    margin-top: 0.25rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--ink-3);
  }

  /* The first-launch warning. Set apart from the metadata above it, because
     it is the one thing on this card the user has to act on: the build is not
     notarised, so macOS refuses it until they say otherwise. Leaving it out —
     as this card did — sends every downloader into a malware dialog with no
     idea it was expected. */
  .note {
    margin-top: 1rem;
    padding-top: 0.875rem;
    border-top: 1px solid var(--line, rgba(255, 255, 255, 0.1));
    font-size: 0.8125rem;
    line-height: 1.5;
    text-align: left;
    color: var(--ink-2);
  }

  .get {
    margin-top: 1.5rem;
    width: 100%;
    background: var(--paper-3);
    color: var(--ink);
  }

  .get:hover {
    background: var(--teal);
    color: #fff;
  }

  .get__arrow {
    display: inline-flex;
  }

  .get:hover .get__arrow {
    animation: nudge 0.9s var(--ease-in-out) infinite;
  }

  @keyframes nudge {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(2px);
    }
  }

  .get--off {
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--hair);
    color: var(--ink-3);
    cursor: not-allowed;
  }

  .get--off:hover {
    background: transparent;
    color: var(--ink-3);
  }

  .alt {
    margin-top: 1.5rem;
    font-size: 0.875rem;
    animation: rise 0.6s var(--ease-out) 300ms both;
  }

  .alt a {
    color: var(--ink-2);
    text-decoration: none;
    border-bottom: 1px solid var(--hair);
    padding-bottom: 1px;
    transition:
      color var(--fast) var(--ease-out),
      border-color var(--fast) var(--ease-out);
  }

  .alt a:hover {
    color: var(--teal-ink);
    border-color: var(--teal);
  }
</style>
