---
import { GITHUB, PRODUCT } from '../config/site';
import Icon from './Icon.astro';
---

<section class="os section">
  <div class="wrap center">
    <h2 class="h2 statement">
      Built in the open, because it reads
      <span class="dim">numbers off your own machine.</span>
    </h2>

    <div class="row">
      <div class="acts">
        <a
          class="btn btn--secondary"
          href={GITHUB.url}
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="github" size={15} />
          View on GitHub
        </a>
        <a
          class="btn btn--secondary"
          href={GITHUB.url}
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="star" size={13} />
          Star
        </a>
      </div>

      <dl class="meta">
        <div>
          <dt>Repository</dt>
          <dd>
            <a href={GITHUB.url} target="_blank" rel="noopener noreferrer"
              >{GITHUB.owner}/{GITHUB.repo}</a
            >
          </dd>
        </div>
        <div>
          <dt>Licence</dt>
          <dd>
            <a href={GITHUB.licenseUrl} target="_blank" rel="noopener noreferrer"
              >{PRODUCT.license}</a
            >
          </dd>
        </div>
        <div>
          <dt>Issues</dt>
          <dd>
            <a href={GITHUB.issuesUrl} target="_blank" rel="noopener noreferrer"
              >Report a bug</a
            >
          </dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<style>
  .statement {
    max-width: 20ch;
    margin-inline: auto;
  }

  .dim {
    color: var(--ink-3);
  }

  .row {
    margin-top: 2.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 2rem;
  }

  .acts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    margin: 0;
    font-size: 0.875rem;
  }

  .meta dt {
    color: var(--ink-3);
    font-size: 0.75rem;
  }

  .meta dd {
    margin: 0.1875rem 0 0;
    font-family: var(--mono);
    font-size: 0.75rem;
  }

  .meta a {
    color: var(--ink-2);
    text-decoration: none;
    white-space: nowrap;
  }

  .meta a:hover {
    color: var(--ink);
  }
</style>
