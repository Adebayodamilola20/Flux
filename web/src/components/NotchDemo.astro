---
/**
 * The product, drawn to its own measurements.
 *
 * Every dimension is the app's, from `native_bridge.dart` at scale 1:
 *   ring 32 / stroke 2.8 · slot 66 · rail 46 wide · vertical padding 28
 *   sliver 11 x 84, radius 5.5 · slot label 12px w700, 3px under the ring
 *   corner radius = 46 * 0.62 · fillet = 46 * 0.46
 *
 * `tilt` presents it as a product shot — the screen turned toward the viewer,
 * the way a photograph of a laptop would be — rather than flat-on.
 */

interface Props {
  /** Angled presentation. Used once, in the hero. */
  tilt?: boolean;
  /** Larger, with the caption. */
  hero?: boolean;
}

const { tilt = false, hero = false } = Astro.props;

interface Slot {
  name: string;
  accent: string;
  used: number;
  windows: { label: string; percent: number; resets: string }[];
  source: string;
}

const slots: Slot[] = [
  {
    name: 'Claude',
    accent: '#D97757',
    used: 0.73,
    windows: [
      { label: 'Current session', percent: 73, resets: 'Resets in 51 min' },
      { label: 'All models', percent: 7, resets: 'Resets Thu 12:00 AM' },
    ],
    source: 'Live from Anthropic',
  },
  {
    name: 'Codex',
    accent: '#10A37F',
    used: 0.21,
    windows: [{ label: 'Codex allowance', percent: 21, resets: 'Resets in 3h 40m' }],
    source: 'Recorded 12m ago',
  },
  {
    name: 'Antigravity',
    accent: '#4285F4',
    used: 0.52,
    windows: [{ label: 'Weekly · Gemini 3 Pro', percent: 52, resets: 'Resets Mon' }],
    source: 'CLI-derived',
  },
];

/** AppPalette.accentFor — the thresholds the app actually uses. */
const accentFor = (f: number) =>
  f >= 0.7 ? 'var(--crit-d)' : f >= 0.45 ? 'var(--warn-d)' : 'var(--ok-d)';

const R = 14.6;
const CIRC = 2 * Math.PI * R;
---

<figure class:list={['demo', tilt && 'demo--tilt', hero && 'demo--hero']}>
  <p class="sr-only">
    The DevNotch rail on the left edge of a Mac display: one ring per tool with
    its percentage beneath, and a card for the focused ring.
  </p>

  <div class="frame">
    <div class="screen" data-screen>
      <!-- Wallpaper: iridescent streaks with grain, the way a real desktop
           picture behaves — the dark rail needs something live to sit on. -->
      <div class="paper" aria-hidden="true">
        <span class="band b1"></span>
        <span class="band b2"></span>
        <span class="band b3"></span>
        <span class="band b4"></span>
        <span class="band b5"></span>
        <svg class="grain" aria-hidden="true">
          <filter id="gr">
            <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="3" />
          </filter>
          <rect width="100%" height="100%" filter="url(#gr)"></rect>
        </svg>
      </div>

      <div class="menubar" aria-hidden="true">
        <span class="mb__glyph"></span>
        <span class="mb__glyph mb__glyph--wide"></span>
        <span class="mb__time">Thu 27 Aug 11.22</span>
      </div>

      <!-- The rail, flush to the left edge. -->
      <div class="rail">
        <div class="rings" data-rings>
          {
            slots.map((s, i) => (
              <button
                class="slot"
                type="button"
                data-slot={i}
                aria-label={`${s.name}, ${Math.round(s.used * 100)} percent used`}
              >
                <span class="ringwrap">
                  <svg class="ring" viewBox="0 0 32 32" width="32" height="32" aria-hidden="true">
                    <circle cx="16" cy="16" r={R} fill="none" stroke="var(--track-d)" stroke-width="2.8" />
                    <circle
                      cx="16" cy="16" r={R} fill="none"
                      stroke={accentFor(s.used)} stroke-width="2.8" stroke-linecap="round"
                      stroke-dasharray={CIRC}
                      style={`--arc:${(CIRC * (1 - s.used)).toFixed(2)}; --d:${i * 90}ms`}
                      transform="rotate(-90 16 16)"
                      class="ring__arc"
                    />
                  </svg>
                  <span class="glyph" style={`background:${s.accent}`} aria-hidden="true" />
                </span>
                {/* 12px, w700, 3px under the ring — as _RailSlot draws it. */}
                <span class="pct">{Math.round(s.used * 100)}%</span>
              </button>
            ))
          }
        </div>

        <button class="gear" type="button" aria-label="DevNotch settings">
          <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
            <path
              d="M12 15.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Z"
              fill="none" stroke="currentColor" stroke-width="2"
            />
            <path
              d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.6 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9v.09a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1Z"
              fill="none" stroke="currentColor" stroke-width="1.6"
            />
          </svg>
        </button>
      </div>

      <!-- One card, which follows the pointer between rings. -->
      <div class="callout" data-callout aria-live="polite">
        {
          slots.map((s, i) => (
            <div class="card" data-card={i} hidden={i !== 0}>
              <div class="card__head">
                <span class="card__dot" style={`background:${s.accent}`} aria-hidden="true" />
                <span class="card__title">{s.name} Usage</span>
              </div>
              {s.windows.map((w) => (
                <div class="win">
                  <div class="win__label">{w.label}</div>
                  <div class="win__track">
                    <span
                      class="win__bar"
                      style={`width:${w.percent}%; background:${accentFor(w.percent / 100)}`}
                    />
                  </div>
                  <div class="win__foot">
                    <span>{w.percent}% Used</span>
                    <span class="win__reset">{w.resets}</span>
                  </div>
                </div>
              ))}
              <div class="card__src">{s.source}</div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-screen]').forEach((screen) => {
    const callout = screen.querySelector<HTMLElement>('[data-callout]')!;
    const cards = [...screen.querySelectorAll<HTMLElement>('[data-card]')];
    const slots = [...screen.querySelectorAll<HTMLElement>('[data-slot]')];

    const focus = (i: number) => {
      callout.style.setProperty('--slot-i', String(i));
      cards.forEach((c, n) => (c.hidden = n !== i));
      slots.forEach((s, n) => s.classList.toggle('is-active', n === i));
    };

    slots.forEach((slot, i) => {
      slot.addEventListener('mouseenter', () => focus(i));
      slot.addEventListener('focus', () => focus(i));
    });

    focus(0);
  });
</script>

<style>
  .demo {
    /* The app's own numbers, at scale 1. */
    --rail: 46px;
    --slot: 66px;
    --pad: 28px;
    --ring: 32px;
    --nub: 11px;
    --corner: 28.5px;
    margin: 0;
  }

  .frame {
    perspective: 1800px;
    perspective-origin: 30% 50%;
  }

  .screen {
    position: relative;
    aspect-ratio: 16 / 10;
    min-height: 320px;
    border-radius: var(--r-xl);
    overflow: hidden;
    background: #05171a;
    box-shadow: var(--shadow-screen);
  }

  /* Turned toward the viewer, as a product photograph would be. Modest
     angles on purpose — past about 16deg the UI text stops being legible. */
  .demo--tilt .screen {
    /* Modest on purpose: past ~10deg the card's text starts to smear. */
    transform: rotateY(8deg) rotateZ(-2.5deg);
    transform-origin: 25% 50%;
    border-radius: 26px;
    box-shadow:
      0 40px 90px -30px rgba(20, 24, 27, 0.55),
      0 8px 24px -12px rgba(20, 24, 27, 0.3);
  }

  .demo--hero .screen {
    aspect-ratio: 16 / 10;
    max-height: 33rem;
  }

  /* ------------------------------------------------------------ wallpaper */

  .paper {
    position: absolute;
    inset: 0;
    background: linear-gradient(150deg, #0b3f52 0%, #12707a 42%, #0a2f3d 100%);
    overflow: hidden;
  }

  /* Iridescent streaks, skewed and blurred so they read as light rather than
     as shapes. */
  .band {
    position: absolute;
    inset: -30% -20%;
    transform: rotate(-24deg);
    filter: blur(34px);
    opacity: 0.85;
  }

  .b1 {
    background: linear-gradient(
      90deg,
      transparent 4%,
      #7fe9dc 14%,
      transparent 26%,
      #4dd0e1 38%,
      transparent 50%
    );
  }
  .b2 {
    background: linear-gradient(
      90deg,
      transparent 20%,
      #ffd28a 30%,
      transparent 40%,
      #ff9068 52%,
      transparent 62%
    );
    opacity: 0.55;
  }
  .b3 {
    background: linear-gradient(
      90deg,
      transparent 44%,
      #b8f7c0 54%,
      transparent 64%
    );
    opacity: 0.45;
  }
  .b4 {
    background: linear-gradient(
      90deg,
      transparent 58%,
      #8fb6ff 70%,
      transparent 82%
    );
    opacity: 0.6;
  }
  .b5 {
    background: linear-gradient(
      90deg,
      transparent 74%,
      #ff8fa3 84%,
      transparent 94%
    );
    opacity: 0.4;
  }

  /* The grain that keeps a gradient from looking like a gradient. */
  .grain {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.22;
    mix-blend-mode: overlay;
    pointer-events: none;
  }

  /* ------------------------------------------------------------- menu bar */

  .menubar {
    position: absolute;
    inset: 0 0 auto 0;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.75rem;
    padding-inline: 0.875rem;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.92);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.35);
    z-index: 2;
  }

  .mb__glyph {
    width: 13px;
    height: 13px;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.55);
  }

  .mb__glyph--wide {
    width: 20px;
    border-radius: 7px;
  }

  .mb__time {
    font-variant-numeric: tabular-nums;
  }

  /* ----------------------------------------------------------------- rail */

  .rail {
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    z-index: 4;
  }

  .rings {
    width: var(--rail);
    padding-block: var(--pad);
    background: #000;
    /* Square against the bezel, rounded away from it. */
    border-radius: 0 var(--corner) var(--corner) 0;
    box-shadow: 0 10px 34px rgba(0, 0, 0, 0.6);
    display: flex;
    flex-direction: column;
  }

  .slot {
    height: var(--slot);
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
  }

  .ringwrap {
    position: relative;
    display: grid;
    place-items: center;
    transition: transform var(--fast) var(--ease-out);
  }

  .slot:hover .ringwrap,
  .slot.is-active .ringwrap {
    transform: translateY(-1.5px) scale(1.06);
  }

  .ring__arc {
    stroke-dashoffset: var(--arc);
    animation: draw 620ms var(--ease-out) both;
    animation-delay: var(--d);
  }

  @keyframes draw {
    from {
      stroke-dashoffset: 91.75;
    }
  }

  .glyph {
    position: absolute;
    width: 11px;
    height: 11px;
    border-radius: 3px;
    opacity: 0.95;
  }

  /* The percentage the app prints beneath each ring. */
  .pct {
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0;
    color: #fff;
    font-variant-numeric: tabular-nums;
  }

  .gear {
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: #000;
    color: rgba(255, 255, 255, 0.75);
    cursor: pointer;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.5);
    transition: color var(--fast) var(--ease-out);
  }

  .gear:hover {
    color: #fff;
  }

  /* ----------------------------------------------------------------- card */

  .callout {
    --slot-i: 0;
    position: absolute;
    left: calc(var(--rail) + 6px);
    top: 50%;
    /* Centre on the rail, then step down to the focused slot. */
    transform: translateY(-50%)
      translateY(calc((var(--slot-i) - 1) * var(--slot)));
    transition: transform var(--mid) var(--ease-out);
    z-index: 5;
    pointer-events: none;
  }

  .card {
    position: relative;
    width: 232px;
    padding: 11px 12px;
    background: #0a0a0b;
    border-radius: 16px;
    color: #fff;
    box-shadow: 0 14px 40px rgba(0, 0, 0, 0.75);
  }

  .card::before {
    content: '';
    position: absolute;
    left: -10px;
    top: 50%;
    width: 12px;
    height: 18px;
    transform: translateY(-50%);
    background: #0a0a0b;
    clip-path: polygon(100% 0, 0 50%, 100% 100%);
  }

  .card__head {
    display: flex;
    align-items: center;
    gap: 7px;
    margin-bottom: 10px;
  }

  .card__dot {
    width: 11px;
    height: 11px;
    border-radius: 3px;
    flex: none;
  }

  .card__title {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .win + .win {
    margin-top: 10px;
  }

  .win__label {
    font-size: 11px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.92);
  }

  .win__track {
    height: 4px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.16);
    margin-top: 5px;
    overflow: hidden;
  }

  .win__bar {
    display: block;
    height: 100%;
    border-radius: 2px;
  }

  .win__foot {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    margin-top: 4px;
    font-size: 10px;
    color: rgba(255, 255, 255, 0.6);
  }

  .win__reset {
    white-space: nowrap;
  }

  .card__src {
    margin-top: 10px;
    padding-top: 8px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-family: var(--mono);
    font-size: 9.5px;
    color: rgba(255, 255, 255, 0.5);
  }

  /* ---------------------------------------------------------- responsive */

  @media (max-width: 60rem) {
    .demo--tilt .screen {
      transform: rotateY(5deg) rotateZ(-1.5deg);
    }
  }

  @media (max-width: 40rem) {
    .demo {
      --rail: 38px;
      --slot: 54px;
      --pad: 20px;
      --corner: 23px;
    }
    .demo--tilt .screen {
      transform: none;
      border-radius: var(--r-lg);
    }
    .screen,
    .demo--hero .screen {
      aspect-ratio: 5 / 4;
      min-height: 0;
    }
    .ring {
      width: 26px;
      height: 26px;
    }
    .pct {
      font-size: 10px;
    }
    .card {
      width: 176px;
      padding: 9px 10px;
    }
    .menubar {
      font-size: 10px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ring__arc {
      animation: none;
    }
  }
</style>
