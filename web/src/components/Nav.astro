---
import { PRODUCT, NAV_LINKS, DOWNLOAD_PATH } from '../config/site';
import Icon from './Icon.astro';
---

<header class="bar">
  <div class="wrap bar__in">
    <a class="brand" href="/">
      <span class="brand__name">
        <span class="brand__dev">Dev</span><span class="brand__notch"
          >Notch<span class="brand__swipe" aria-hidden="true" /></span
        >
      </span>
      <span class="brand__v">v{PRODUCT.version}</span>
    </a>

    <nav class="links" aria-label="Sections">
      {
        NAV_LINKS.map((l) => (
          <a class="btn btn--ghost btn--sm" href={l.href}>
            {l.label}
          </a>
        ))
      }
    </nav>

    <a class="btn btn--soft btn--sm cta" href={DOWNLOAD_PATH}>
      <Icon name="apple" size={15} />
      <span>Download<span class="only-wide"> for Mac</span></span>
    </a>
  </div>
</header>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 86%, transparent);
    backdrop-filter: saturate(180%) blur(16px);
    -webkit-backdrop-filter: saturate(180%) blur(16px);
  }

  .bar__in {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-block: 0.75rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-right: auto;
    padding: 0.375rem;
    text-decoration: none;
    flex: none;
  }

  .brand__name {
    position: relative;
    font-weight: 600;
    font-size: 1.25rem;
    letter-spacing: -0.035em;
    line-height: 1;
    white-space: nowrap;
  }

  .brand__dev {
    color: var(--ink-2);
  }

  /* The product's half of its own name carries the weight and the mark. */
  .brand__notch {
    position: relative;
    font-weight: 700;
    color: var(--ink);
  }

  /* The notch itself, drawn as a swipe under its own syllable. */
  .brand__swipe {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.24em;
    height: 3px;
    border-radius: 2px;
    background: var(--teal);
    transform-origin: left center;
    transform: scaleX(1);
    transition: transform var(--mid) var(--ease-out);
  }

  .brand:hover .brand__swipe {
    transform: scaleX(1.08);
  }

  .brand__v {
    padding: 0.15rem 0.35rem;
    border-radius: var(--r-sm);
    background: rgba(20, 24, 27, 0.07);
    font-size: 0.6875rem;
    font-weight: 600;
  }

  .links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    flex: none;
  }

  .cta {
    flex: none;
  }

  @media (max-width: 60rem) {
    .links {
      display: none;
    }
  }

  @media (max-width: 26rem) {
    .only-wide,
    .brand__v {
      display: none;
    }
  }
</style>
